# Copier ce fichier en .env puis adapter si besoin

# Serveur compatible OpenAI
# - local (développement) : Ollama -> http://localhost:11434/v1
# - GPU (expériences)     : vLLM   -> http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=EMPTY
DEFAULT_MODEL=qwen2.5-instruct:1.5b

TEMPERATURE=0.7
MAX_TOKENS=2048
SEED=0
MAX_CONCURRENCY=8
LOG_LEVEL=INFO
