# Copier ce fichier en .env puis renseigner les valeurs

# LLM : anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_TEMPERATURE=0.0

# Clés API (seulement celle du provider choisi)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings (modèle HuggingFace local, multilingue)
EMBEDDING_MODEL=BAAI/bge-m3

# ChromaDB (lancé via docker compose)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=documents

DATA_DIR=data/raw
API_PORT=8080
LOG_LEVEL=INFO
