# Copier ce fichier en .env puis adapter si besoin

# LLM : ollama (local) | anthropic | openai
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (servis par Ollama)
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=64

# Chunking : semantic | recursive
CHUNK_STRATEGY=semantic
CHUNK_MAX_CHARS=1500
CHUNK_MIN_CHARS=200
CHUNK_BREAKPOINT_PERCENTILE=90

# ChromaDB : local (fichiers dans data/chroma) | http (docker compose, port 8001)
CHROMA_MODE=local
CHROMA_COLLECTION=documents

DATA_DIR=data/raw
PROCESSED_DIR=data/processed
LOG_LEVEL=INFO
